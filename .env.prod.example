# ══════════════════════════════════════════════════════════
# Astra – Produktions-Umgebung
#   cp .env.prod.example .env  &&  Werte anpassen
#
# Secrets erzeugen:  python3 -c "import secrets; print(secrets.token_hex(32))"
# ══════════════════════════════════════════════════════════

# Damit `docker compose ...` immer das Produktions-File nutzt (auch scripts/backup.sh)
COMPOSE_FILE=docker-compose.prod.yml

# ── Domains ──────────────────────────────────────────────
# Panel: DNS-A-Record muss auf diesen Server zeigen (Ports 80/443 offen)
PANEL_DOMAIN=panel.example.com
# Optional: Wings-Node auf DEMSELBEN Host hinter Caddy (TLS durch Caddy, Wings auf :8080 ohne SSL).
# Leer lassen, wenn Wings auf einem anderen Server laeuft oder eigene Zertifikate nutzt.
NODE_DOMAIN=node1.example.com
# Kontakt fuer Let's Encrypt
ACME_EMAIL=admin@example.com

# ── Secrets (PFLICHT) ────────────────────────────────────
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# ── Datenbank ────────────────────────────────────────────
POSTGRES_DB=astra
POSTGRES_USER=astra

# ── Erster Admin (nur fuer scripts/deploy.sh --bootstrap) ─
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-after-first-login

# ── Runner / Wings ───────────────────────────────────────
RUNNER_ADAPTER=wings
RUNNER_TIMEOUT_CONNECT=5
RUNNER_TIMEOUT_READ=30

# ── Jobs / Queue ─────────────────────────────────────────
# redis = asynchron ueber den worker-Container (empfohlen), sync = im Request
JOB_QUEUE_BACKEND=redis
GUNICORN_WORKERS=4

# ── Self-Service ─────────────────────────────────────────
# Registrierung fuer Kunden freischalten (Phase 3). Vorher: false.
REGISTRATION_ENABLED=false
PASSWORD_RESET_TTL_MINUTES=60

# ── Mail (fuer Passwort-Reset / Registrierung) ──────────
# Leer lassen = Mails werden nur geloggt
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=astra@example.com

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=WARNING
