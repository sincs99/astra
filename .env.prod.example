# ══════════════════════════════════════════════════════════
# Astra – Produktions-Umgebung
#   cp .env.prod.example .env  &&  Werte anpassen
#
# Secrets erzeugen:  python3 -c "import secrets; print(secrets.token_hex(32))"
# ══════════════════════════════════════════════════════════

# Damit `docker compose ...` immer das Produktions-File nutzt (auch scripts/backup.sh)
COMPOSE_FILE=docker-compose.prod.yml

# ── Domains ──────────────────────────────────────────────
# Panel: DNS-A-Record muss auf diesen Server zeigen (Ports 80/443 offen)
PANEL_DOMAIN=panel.example.com
# Optional: Wings-Node auf DEMSELBEN Host hinter Caddy (TLS durch Caddy, Wings auf :8080 ohne SSL).
# Leer lassen, wenn Wings auf einem anderen Server laeuft oder eigene Zertifikate nutzt.
NODE_DOMAIN=node1.example.com
# Kontakt fuer Let's Encrypt
ACME_EMAIL=admin@example.com

# ── Secrets (PFLICHT) ────────────────────────────────────
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# ── Datenbank ────────────────────────────────────────────
POSTGRES_DB=astra
POSTGRES_USER=astra

# ── Erster Admin (nur fuer scripts/deploy.sh --bootstrap) ─
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-after-first-login

# ── Runner / Wings ───────────────────────────────────────
RUNNER_ADAPTER=wings
RUNNER_TIMEOUT_CONNECT=5
RUNNER_TIMEOUT_READ=30

# ── Jobs / Queue ─────────────────────────────────────────
# redis = asynchron ueber den worker-Container (empfohlen), sync = im Request
JOB_QUEUE_BACKEND=redis
GUNICORN_WORKERS=4

# ── Self-Service ─────────────────────────────────────────
# Registrierung fuer Kunden freischalten (Phase 3). Vorher: false.
REGISTRATION_ENABLED=false
PASSWORD_RESET_TTL_MINUTES=60

# ── Abrechnung (Phase 4) ─────────────────────────────────
# Tage zwischen Laufzeitende (Sperre) und Loeschung des Servers
BILLING_GRACE_DAYS=7
# Sekunden zwischen zwei Billing-Ticks (Container "billing")
BILLING_TICK_INTERVAL=300
# Tage vor Laufzeitende fuer die Erinnerungsmail (0 = aus)
BILLING_REMINDER_DAYS=3
# Warnung (Preflight, GET /api/admin/billing/status), wenn der Tick so viele Minuten nicht lief
BILLING_TICK_MAX_AGE_MINUTES=15
# Warnung (Preflight, billing/status), wenn eine bezahlte Bestellung so viele Stunden auf einen freien Node wartet
BILLING_WAIT_WARN_HOURS=24

# ── Admin-Benachrichtigung (M58, alles leer = aus) ──────
# Mail-Adresse(n), kommagetrennt (braucht MAIL_SERVER)
ADMIN_ALERT_EMAIL=
# Webhook, JSON-POST mit "content" (Discord) und "text" (Slack); enthaelt oft ein Geheimnis, nie committen
ADMIN_ALERT_WEBHOOK_URL=
# Eine anhaltende Stoerung wird hoechstens alle so viele Minuten erneut gemeldet
ADMIN_ALERT_COOLDOWN_MINUTES=360
# Einmalige Entwarnung, wenn eine Stoerung behoben ist
ADMIN_ALERT_RECOVERY=true
# Sekunden zwischen zwei Pruefungen (Container "alerts")
ALERT_CHECK_INTERVAL=300

# ── Registrierungsschutz (M71) ──────────────────────────
# Rate-Limits je IP bzw. Konto (RATELIMIT_ENABLED muss true sein, in Produktion ist es das)
RATELIMIT_REGISTER_PER_HOUR=5
RATELIMIT_LOGIN_PER_MINUTE=10
RATELIMIT_LOGIN_FAILURES_PER_HOUR=20
RATELIMIT_PASSWORD_RESET_PER_HOUR=3
# CAPTCHA fuer Registrierung und Passwort-Reset: none | turnstile | hcaptcha (Keys beim Anbieter anlegen)
# Hinweis Datenschutz: das Widget laedt Skripte des Anbieters, bitte in der Datenschutzerklaerung nennen
CAPTCHA_PROVIDER=none
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=

# ── Zahlungsbelege (M62, kein Steuerbeleg) ───────────────
# Nummernformat: {year} und {seq}; die laufende Nummer beginnt jedes Jahr bei 1. Spaeter nicht mehr aendern.
INVOICE_NUMBER_FORMAT=AST-{year}-{seq:05d}
# Anbieter im Kopf des Belegs (\n fuer Zeilenumbruch, Werte mit Leerzeichen in Anfuehrungszeichen), leer = weglassen
INVOICE_SELLER=
# Fusszeile, z.B. Hinweis zu Steuern oder Kontakt (\n fuer Zeilenumbruch), leer = weglassen
RECEIPT_FOOTER=
# Umsatzsteuer (M70): Preise sind Bruttopreise. 0 = Kleinunternehmer (Hinweis nach § 19 UStG), sonst z.B. 19
VAT_RATE=0
# USt-IdNr. des Anbieters (optional)
INVOICE_SELLER_VAT_ID=
# Hinweis bei Satz 0; leer lassen = Standardtext (DE/EN). Vor dem Echtbetrieb mit dem Steuerberater abstimmen
INVOICE_SMALL_BUSINESS_NOTE=

# ── Zahlung ──────────────────────────────────────────────
# manual = Admin schaltet nach Zahlungseingang frei (Standard, kein Konto noetig)
# stripe = Online-Zahlung per Stripe Checkout; Webhook-URL im Stripe-Dashboard:
#          https://<PANEL_DOMAIN>/api/payments/stripe (Event checkout.session.completed)
PAYMENT_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Mail (fuer Passwort-Reset / Registrierung) ──────────
# Leer lassen = Mails werden nur geloggt
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=astra@example.com

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=WARNING
