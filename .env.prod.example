# ══════════════════════════════════════════════════════════
# Astra – Produktions-Umgebung
#   cp .env.prod.example .env  &&  Werte anpassen
#
# Secrets erzeugen:  python3 -c "import secrets; print(secrets.token_hex(32))"
# ══════════════════════════════════════════════════════════

# Damit `docker compose ...` immer das Produktions-File nutzt (auch scripts/backup.sh)
COMPOSE_FILE=docker-compose.prod.yml

# ── Domains ──────────────────────────────────────────────
# Panel: DNS-A-Record muss auf diesen Server zeigen (Ports 80/443 offen)
PANEL_DOMAIN=panel.example.com
# Optional: Wings-Node auf DEMSELBEN Host hinter Caddy (TLS durch Caddy, Wings auf :8080 ohne SSL).
# Leer lassen, wenn Wings auf einem anderen Server laeuft oder eigene Zertifikate nutzt.
NODE_DOMAIN=node1.example.com
# Kontakt fuer Let's Encrypt
ACME_EMAIL=admin@example.com

# ── Secrets (PFLICHT) ────────────────────────────────────
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# ── Datenbank ────────────────────────────────────────────
POSTGRES_DB=astra
POSTGRES_USER=astra

# ── Erster Admin (nur fuer scripts/deploy.sh --bootstrap) ─
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-after-first-login

# ── Runner / Wings ───────────────────────────────────────
RUNNER_ADAPTER=wings
RUNNER_TIMEOUT_CONNECT=5
RUNNER_TIMEOUT_READ=30

# ── Jobs / Queue ─────────────────────────────────────────
# redis = asynchron ueber den worker-Container (empfohlen), sync = im Request
JOB_QUEUE_BACKEND=redis
GUNICORN_WORKERS=4

# ── Self-Service ─────────────────────────────────────────
# Registrierung fuer Kunden freischalten (Phase 3). Vorher: false.
REGISTRATION_ENABLED=false
PASSWORD_RESET_TTL_MINUTES=60

# ── Abrechnung (Phase 4) ─────────────────────────────────
# Tage zwischen Laufzeitende (Sperre) und Loeschung des Servers
BILLING_GRACE_DAYS=7
# Sekunden zwischen zwei Billing-Ticks (Container "billing")
BILLING_TICK_INTERVAL=300
# Tage vor Laufzeitende fuer die Erinnerungsmail (0 = aus)
BILLING_REMINDER_DAYS=3
# Warnung (Preflight, GET /api/admin/billing/status), wenn der Tick so viele Minuten nicht lief
BILLING_TICK_MAX_AGE_MINUTES=15
# Warnung (Preflight, billing/status), wenn eine bezahlte Bestellung so viele Stunden auf einen freien Node wartet
BILLING_WAIT_WARN_HOURS=24

# ── Zahlung ──────────────────────────────────────────────
# manual = Admin schaltet nach Zahlungseingang frei (Standard, kein Konto noetig)
# stripe = Online-Zahlung per Stripe Checkout; Webhook-URL im Stripe-Dashboard:
#          https://<PANEL_DOMAIN>/api/payments/stripe (Event checkout.session.completed)
PAYMENT_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Mail (fuer Passwort-Reset / Registrierung) ──────────
# Leer lassen = Mails werden nur geloggt
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=astra@example.com

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=WARNING
